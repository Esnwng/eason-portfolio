---
import Layout from './Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import Icons from './Icons.astro';
import { Image } from 'astro:assets';
const { gallery, full, next, ogImage } = Astro.props;
const metaBits = [gallery.data.location, gallery.data.year, `${gallery.count} ${gallery.count === 1 ? 'image' : 'images'}`].filter(Boolean);
---
<Layout title={gallery.data.title} description={gallery.data.description || `${gallery.data.title} — photography by Eason Wang.`} ogImage={ogImage}>
  <div class="container page-head">
    <a class="back" href="/photography"><Icons name="arrow" /> All series</a>
    <h1 class="page-head__title" style="margin-top:28px" data-reveal>{gallery.data.title}</h1>
    {gallery.data.description && <p class="page-head__desc" data-reveal style="--i:1">{gallery.data.description}</p>}
    <div class="page-head__meta" data-reveal style="--i:2">{metaBits.map((m) => <span class="meta">{m}</span>)}</div>
  </div>
  <div class="container">
    <div class="masonry">
      {gallery.images.map((img, i) => (
        <a class="ph" href={full[i]} data-lightbox={gallery.id} data-alt={`${gallery.data.title} ${i + 1}`} data-reveal style={`--i:${Math.min(i, 6)}`}>
          <Image src={img.src} alt={`${gallery.data.title} ${i + 1}`} widths={[480, 800, 1100]} sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 33vw" quality={80} loading={i < 6 ? 'eager' : 'lazy'} />
        </a>
      ))}
      {gallery.data.videos.map((v) => <div class="ph" style="cursor:default" data-reveal><video controls playsinline preload="none" poster={v.poster || undefined} src={v.src}></video></div>)}
    </div>
    {next && next.id !== gallery.id && <p style="margin-top: 48px" data-reveal><a class="link-arrow" href={`/photography/${next.id}`}>Next series: {next.data.title} <Icons name="arrow" /></a></p>}
  </div>
  <Lightbox />
</Layout>
