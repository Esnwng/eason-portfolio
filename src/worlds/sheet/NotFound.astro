---
import Layout from './Layout.astro';
---
<Layout title="Not found">
  <div class="sheet">
    <div class="strip" aria-hidden="true">
      <ol class="reel reel--strip reel--blank">
        <li class="fb leader" style="grid-column: 1 / -1; --perfs: calc(8 * var(--n))"></li>
      </ol>
    </div>
  </div>
  <div class="page head lost">
    <h1 class="display title">No frame here.</h1>
    <p class="lead">This page is not on the sheet. <a href="/">Back to the contact sheet</a>.</p>
  </div>
</Layout>
