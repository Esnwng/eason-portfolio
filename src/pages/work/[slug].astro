---
import FilmPage from '@world/FilmPage.astro';
import { filmPageProps } from '../../lib/pages';
import { getFilms } from '../../lib/content';
export async function getStaticPaths() {
  const films = await getFilms();
  return films.map((film) => ({ params: { slug: film.id }, props: { film } }));
}
const props = await filmPageProps(Astro.props.film);
---
<FilmPage {...props} />
