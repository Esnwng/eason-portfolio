---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import FilmCard from '../components/FilmCard.astro';
import GalleryTile from '../components/GalleryTile.astro';
import Recognition from '../components/Recognition.astro';
import { getSite, getFilms, getGalleries, imagesFor } from '../lib/content';
import { getImage } from 'astro:assets';

const site = await getSite();
const films = await getFilms();
const galleries = await getGalleries();
const heroImage = imagesFor(site.hero.gallery).find((i) => i.file === site.hero.file)?.src ?? galleries[0]?.cover;
if (!heroImage) throw new Error('No hero image: check site.json "hero"');
const og = await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---
<Base ogImage={og.src}>
  <Hero image={heroImage} name={site.name} tagline={site.tagline} roles={site.roles} />

  {films.length > 0 && (
    <section class="section" id="work">
      <div class="container">
        <SectionHead title="Selected Work" href="/work" linkText="View all work" />
        {films.slice(0, 3).map((f, i) => <FilmCard film={f} index={i} />)}
      </div>
    </section>
  )}

  {galleries.length > 0 && (
    <section class="section" id="photography">
      <div class="container">
        <SectionHead title="Photography" href="/photography" linkText="View all photography" />
        <div class="grid-galleries">
          {galleries.slice(0, 4).map((g, i) => <GalleryTile gallery={g} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <Recognition />

  <section class="section" id="about">
    <div class="container about">
      <div data-reveal>
        <h2 class="section__title">About</h2>
        <p class="meta" style="margin-top:14px">{site.roles.join(' · ')}</p>
      </div>
      <div class="prose" data-reveal style="--i:1">
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container about">
      <div data-reveal><h2 class="section__title">Contact</h2></div>
      <div class="prose" data-reveal style="--i:1">
        {site.contact.email ? <p><a href={`mailto:${site.contact.email}`} class="lede">{site.contact.email}</a></p> : <p>{site.contact.note}</p>}
        {site.contact.instagram && <p style="margin-top:8px"><a href={`https://instagram.com/${site.contact.instagram}`} target="_blank" rel="noopener">@{site.contact.instagram}</a></p>}
      </div>
    </div>
  </section>
</Base>
