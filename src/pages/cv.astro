---
import Base from '../layouts/Base.astro';
import { getSite, getFilms, getAwards, getExhibitions, getPress, getGalleries, formatDate } from '../lib/content';
const [site, films, awards, exhibitions, press, galleries] = await Promise.all([getSite(), getFilms(), getAwards(), getExhibitions(), getPress(), getGalleries()]);
const filmTitle = (id: string) => films.find((f) => f.id === id)?.data.title ?? id;
---
<Base title="CV" description={`Curriculum vitae of ${site.name}: filmography, awards, exhibitions and press.`}>
  <div class="container page-head" style="padding-bottom: 8px">
    <p class="meta meta--gold" data-reveal>Curriculum Vitae</p>
    <h1 class="page-head__title" data-reveal style="--i:1">{site.name}</h1>
    <p class="page-head__desc" data-reveal style="--i:2">{site.tagline}. {site.about[0]}</p>
    <p class="no-print" style="margin-top:22px" data-reveal><button class="btn" type="button" onclick="window.print()">Print / Save as PDF</button></p>
  </div>
  <div class="container cv">
    {films.length > 0 && (
      <section data-reveal>
        <h2>Filmography</h2>
        <table>
          <thead><tr><th>Title</th><th>Year</th><th>Role</th><th>Notes</th></tr></thead>
          <tbody>{films.map((f) => <tr><td><a href={`/work/${f.id}`}>{f.data.title}</a></td><td class="date">{f.data.year}</td><td>{f.data.role}</td><td>{f.data.logline}</td></tr>)}</tbody>
        </table>
      </section>
    )}
    {awards.length > 0 && (
      <section data-reveal>
        <h2>Awards & Selections</h2>
        <table>
          <thead><tr><th>Date</th><th>Award</th><th>Festival</th><th>Work</th></tr></thead>
          <tbody>{awards.map((a) => <tr><td class="date">{formatDate(a.data.date)}</td><td>{a.data.title}{a.data.category ? `, ${a.data.category}` : ''}</td><td>{a.data.url ? <a href={a.data.url}>{a.data.festival}</a> : a.data.festival}{a.data.location ? `, ${a.data.location}` : ''}</td><td>{a.data.work ? filmTitle(a.data.work) : ''}{a.data.role ? ` (${a.data.role})` : ''}</td></tr>)}</tbody>
        </table>
      </section>
    )}
    {exhibitions.length > 0 && (
      <section data-reveal>
        <h2>Exhibitions</h2>
        <table>
          <thead><tr><th>Date</th><th>Exhibition</th><th>Venue</th><th>Role</th></tr></thead>
          <tbody>{exhibitions.map((x) => <tr><td class="date">{formatDate(x.data.date)}</td><td>{x.data.url ? <a href={x.data.url}>{x.data.title}</a> : x.data.title}</td><td>{x.data.venue}{x.data.location ? `, ${x.data.location}` : ''}</td><td>{x.data.role}</td></tr>)}</tbody>
        </table>
      </section>
    )}
    {press.length > 0 && (
      <section data-reveal>
        <h2>Press</h2>
        <table>
          <thead><tr><th>Date</th><th>Headline</th><th>Outlet</th></tr></thead>
          <tbody>{press.map((p) => <tr><td class="date">{formatDate(p.data.date)}</td><td>{p.data.url ? <a href={p.data.url}>{p.data.title}</a> : p.data.title}</td><td>{p.data.outlet}</td></tr>)}</tbody>
        </table>
      </section>
    )}
    {galleries.length > 0 && (
      <section data-reveal>
        <h2>Photography Series</h2>
        <table>
          <thead><tr><th>Series</th><th>Location</th><th>Year</th><th>Images</th></tr></thead>
          <tbody>{galleries.map((g) => <tr><td><a href={`/photography/${g.id}`}>{g.data.title}</a></td><td>{g.data.location}</td><td class="date">{g.data.year}</td><td>{g.count}</td></tr>)}</tbody>
        </table>
      </section>
    )}
  </div>
</Base>
