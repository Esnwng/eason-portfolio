---
import { getSite } from '../lib/content';
const site = await getSite();
const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/photography', label: 'Photography' },
  { href: '/#about', label: 'About' },
  { href: '/cv', label: 'CV' },
];
const isCurrent = (href: string) => href !== '/#about' && (path === href || path.startsWith(href + '/'));
---
<header class="nav" transition:persist>
  <div class="container nav__inner">
    <a class="nav__brand" href="/">{site.name}</a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
