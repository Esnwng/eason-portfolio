---
import { getSite } from '../lib/content';
const site = await getSite();
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <div>
      <div class="footer__brand">{site.name}</div>
      <div class="meta" style="margin-top:6px">{site.tagline}</div>
    </div>
    <div class="footer__links">
      <a href="/work">Work</a><a href="/photography">Photography</a><a href="/#about">About</a><a href="/cv">CV</a>
    </div>
    <div class="meta" style="color:var(--ink-3)">© {year} {site.name}{site.footerNote ? ` · ${site.footerNote}` : ''}</div>
  </div>
</footer>
